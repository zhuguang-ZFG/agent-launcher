<Window x:Class="AgentLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="多 Agent 启动器" Width="1120" Height="800" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="RestoreBackupButton" Content="恢复备份" Click="RestoreBackupClick" Visibility="Collapsed" Margin="0,0,8,0"/>
     <Button Content="工作目录" Style="{StaticResource QuietButton}" Click="WorkspacesClick" Margin="0,0,8,0"/>
     <Button Content="设置" Style="{StaticResource QuietButton}" Click="SettingsClick" AutomationProperties.AutomationId="Settings"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" Background="{DynamicResource Ink}" CornerRadius="6" Margin="0,0,12,0">
      <Path Data="M 7 8 L 11 12 L 7 16 M 14 16 L 20 16" Stroke="{DynamicResource Surface}" StrokeThickness="1.5"/>
     </Border>
     <TextBlock Text="多 Agent 启动器" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Editor" Margin="24,20,24,24">
    <Border x:Name="ProjectPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
     <StackPanel>
      <DockPanel Margin="0,0,0,12">
       <Button DockPanel.Dock="Right" Content="选择文件夹" Click="ChooseClick" AutomationProperties.AutomationId="ChooseProject" Margin="12,0,0,0"/>
       <StackPanel><TextBlock Text="项目" Style="{StaticResource Caption}"/><TextBlock x:Name="ProjectTitle" Text="从一个项目开始" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
      <TextBox x:Name="ProjectPath" FontFamily="Consolas,Microsoft YaHei" FontSize="13" AutomationProperties.Name="默认项目路径" AutomationProperties.AutomationId="ProjectPath" LostKeyboardFocus="ProjectLostFocus" ToolTip="输入本地绝对目录，或拖入文件夹"/>
      <DockPanel Margin="0,8,0,0"><ComboBox DockPanel.Dock="Right" x:Name="Recent" Width="200" SelectionChanged="RecentChanged" AutomationProperties.Name="最近项目" Visibility="Collapsed"/><TextBlock Text="将文件夹拖到窗口，或选择本地项目" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
    </Border>
    <Grid x:Name="WorkGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConfigColumn" Width="*"/><ColumnDefinition x:Name="SummaryColumn" Width="320"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="ConfigurationPanel" Margin="0,0,20,0">
      <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" x:Name="SelectionSummary" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="本次 Agent" Style="{StaticResource Heading}"/></DockPanel>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
       <StackPanel>
        <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="Templates" SelectionChanged="TemplateChanged" AutomationProperties.Name="恢复组合" MaxWidth="260" HorizontalAlignment="Left"/>
         <Button Grid.Column="1" Content="另存组合" Style="{StaticResource QuietButton}" Click="SaveTemplateClick" Margin="8,0,0,0"/>
        </Grid>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><StackPanel x:Name="SlotList"/></Border>
        <Button x:Name="AddButton" Content="＋  添加 Agent" Style="{StaticResource QuietButton}" Click="AddClick" HorizontalAlignment="Left" Margin="12,8,12,12"/>
       </StackPanel>
      </Border>
      <Expander x:Name="SessionExpander" Margin="0,20,0,0" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch">
       <Expander.Header><TextBlock x:Name="SessionHeading" Text="运行记录" FontWeight="SemiBold" Margin="4,0"/></Expander.Header>
       <StackPanel Margin="0,12,0,0"><StackPanel x:Name="Sessions"/><TextBlock x:Name="ProgressText" Margin="0,8" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel x:Name="SummaryPanel" Grid.Column="1">
      <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="配置示意" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="终端布局" Style="{StaticResource Heading}"/></DockPanel>
      <Border Background="#191B20" BorderBrush="#34373F" BorderThickness="1" CornerRadius="10" Padding="12">
       <StackPanel>
        <DockPanel Margin="4,0,4,12"><TextBlock DockPanel.Dock="Right" x:Name="PaneCount" Text="1 个窗格" Foreground="#A5ABB6" FontSize="12"/><TextBlock Text="Windows Terminal" Foreground="#D7DBE2" FontSize="12"/></DockPanel>
        <Grid x:Name="Preview" MinHeight="144"/>
       </StackPanel>
      </Border>
      <DockPanel Margin="0,12,0,20"><TextBlock Text="两项排列" Style="{StaticResource Caption}" VerticalAlignment="Center"/><ComboBox x:Name="Layout" Width="128" HorizontalAlignment="Right" SelectionChanged="LayoutChanged" AutomationProperties.Name="两项布局"><ComboBoxItem Content="左右" Tag="vertical"/><ComboBoxItem Content="上下" Tag="horizontal"/></ComboBox></DockPanel>
      <TextBlock Text="工作目录" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="DirectoryMode" SelectionChanged="DirectoryChanged" AutomationProperties.Name="同项目目录策略"><ComboBoxItem Content="各自独立" Tag="isolated"/><ComboBoxItem Content="使用已准备目录" Tag="prepared"/><ComboBoxItem Content="共用原目录" Tag="shared"/></ComboBox>
      <TextBlock x:Name="DirectoryHelp" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
       <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="详情" Style="{StaticResource QuietButton}" Click="ResourceClick" MinHeight="28" Padding="8,2"/><TextBlock Text="资源预算" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="可用内存" Style="{StaticResource Caption}"/><TextBlock x:Name="AvailableValue" Text="—" FontFamily="Consolas" FontSize="24" Margin="0,4,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="本次预算" Style="{StaticResource Caption}"/><TextBlock x:Name="BudgetValue" Text="2 GiB" FontFamily="Consolas" FontSize="24" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ResourceText" Style="{StaticResource Caption}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
   <StackPanel>
    <Border x:Name="ErrorBanner" Background="{DynamicResource WarningSurface}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarningInk}" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer>
    </Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="LaunchHint" Text="先选择项目文件夹"/><TextBlock x:Name="SaveStatus" Text="配置自动保存" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="CancelButton" Content="停止后续步骤" Style="{StaticResource QuietButton}" IsEnabled="False" Click="CancelClick" Margin="0,0,8,0"><Button.Visibility><Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" Converter="{StaticResource BooleanVisibility}"/></Button.Visibility></Button>
      <Button x:Name="LaunchButton" Content="启动 1 个 Agent" Style="{StaticResource PrimaryButton}" MinWidth="168" Click="LaunchClick" AutomationProperties.AutomationId="Launch"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
