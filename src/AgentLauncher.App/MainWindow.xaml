<Window x:Class="AgentLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="多 Agent 启动器" Width="1120" Height="800" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
   <DockPanel x:Name="HeaderPanel">
    <WrapPanel x:Name="HeaderActions" DockPanel.Dock="Right">
     <Button x:Name="RestoreBackupButton" Content="恢复备份" Click="RestoreBackupClick" Visibility="Collapsed" Margin="0,0,8,0"/>
     <Button Content="工作目录" Style="{StaticResource QuietButton}" Click="WorkspacesClick" Margin="0,0,8,0"/>
     <Button Content="设置" Style="{StaticResource QuietButton}" Click="SettingsClick" AutomationProperties.AutomationId="Settings"/>
    </WrapPanel>
    <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" Background="{DynamicResource Ink}" CornerRadius="6" Margin="0,0,12,0">
      <Path Data="M 7 8 L 11 12 L 7 16 M 14 16 L 20 16" Stroke="{DynamicResource Surface}" StrokeThickness="1.5"/>
     </Border>
     <TextBlock Text="多 Agent 启动器" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Editor" Margin="24,16,24,24">
    <Border x:Name="ProjectPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
     <StackPanel>
      <DockPanel Margin="0,0,0,10">
       <Button DockPanel.Dock="Right" x:Name="ChooseProjectButton" Content="选择文件夹" Click="ChooseClick" AutomationProperties.AutomationId="ChooseProject" Margin="12,0,0,0" VerticalAlignment="Top"/>
       <DockPanel VerticalAlignment="Center"><TextBlock Text="项目" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="ProjectTitle" Text="还没有选择项目" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel>
      </DockPanel>
      <TextBox x:Name="ProjectPath" FontFamily="Consolas,Microsoft YaHei" FontSize="13" AutomationProperties.Name="默认项目路径" AutomationProperties.AutomationId="ProjectPath" LostKeyboardFocus="ProjectLostFocus" ToolTip="输入本地绝对目录，或拖入文件夹"/>
      <DockPanel Margin="0,6,0,0"><ComboBox DockPanel.Dock="Right" x:Name="Recent" Width="200" SelectionChanged="RecentChanged" AutomationProperties.Name="最近项目" Visibility="Collapsed"/><TextBlock x:Name="ProjectGuide" Text="① 选择或拖入项目文件夹　② 在左侧勾选 Agent　③ 在右侧检查资源后点「启动」" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
    </Border>
    <Grid x:Name="WorkGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConfigColumn" Width="*"/><ColumnDefinition x:Name="SummaryColumn" Width="320"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="ConfigurationPanel" Margin="0,0,20,0">
      <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" x:Name="SelectionSummary" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="要一起启动的 Agent" Style="{StaticResource Heading}"/></DockPanel>
      <WrapPanel x:Name="ScalePresets" Margin="0,0,0,8" AutomationProperties.Name="可配置规模预设">
       <TextBlock Text="规模预设" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <Button Content="1" Tag="1" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 1"/>
       <Button Content="2" Tag="2" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 2"/>
       <Button Content="4" Tag="4" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 4"/>
       <Button Content="8" Tag="8" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 8"/>
       <Button Content="16" Tag="16" Click="ScalePresetClick" MinWidth="40" Margin="0,0,4,4" AutomationProperties.Name="规模预设 16"/>
      </WrapPanel>
      <TextBlock Text="只勾选的项会启动；预设用于补齐配置。缩小不会删除已编辑项。" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
       <StackPanel>
        <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <DockPanel VerticalAlignment="Center"><TextBlock Text="组合模板" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Templates" SelectionChanged="TemplateChanged" AutomationProperties.Name="恢复组合" MaxWidth="260" HorizontalAlignment="Left"/></DockPanel>
         <Button Grid.Column="1" x:Name="SaveTemplateButton" Content="存为组合" Style="{StaticResource QuietButton}" Click="SaveTemplateClick" Margin="8,0,0,0"/>
        </Grid>
        <DockPanel Margin="16,0,16,12">
         <Label Content="筛选下拉选项" Target="{Binding ElementName=AgentSearch}" VerticalAlignment="Center" Padding="0,0,8,0" ToolTip="只筛选各项的 Agent 下拉选项，不隐藏配置行，也不改变勾选"/>
         <TextBox x:Name="AgentSearch" AutomationProperties.Name="搜索 Agent 名称" AutomationProperties.HelpText="按名称筛选 Agent 下拉选项，不改变已勾选项" ToolTip="按名称筛选下拉选项；不会改变已选择的 Agent" TextChanged="AgentSearchChanged"/>
        </DockPanel>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><StackPanel x:Name="SlotList"/></Border>
        <WrapPanel Margin="12,8,12,12"><Button x:Name="AddButton" Content="＋  添加 Agent" Style="{StaticResource QuietButton}" Click="AddClick"/><Button x:Name="DiscoverButton" Content="重新查找本机 CLI" Style="{StaticResource QuietButton}" Click="DiscoverClick" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock x:Name="DiscoveryStatus" Text="正在查找本机 CLI…" Style="{StaticResource Caption}" Margin="16,0,16,12" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
      <Expander x:Name="SessionExpander" Margin="0,16,0,0" MinHeight="36" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" ToolTip="展开查看本次与本机运行记录">
       <Expander.Header><TextBlock x:Name="SessionHeading" Text="运行记录" FontWeight="SemiBold" Margin="4,0" MinHeight="36" VerticalAlignment="Center"/></Expander.Header>
       <StackPanel Margin="0,12,0,0"><StackPanel x:Name="Sessions"/><TextBlock x:Name="ProgressText" Margin="0,8" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      </Expander>
      <Expander x:Name="TaskExpander" Margin="0,8,0,0" MinHeight="36" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="任务队列" ToolTip="任务卡片、队列与人工验收">
       <Expander.Header><TextBlock x:Name="TaskHeading" Text="任务队列" FontWeight="SemiBold" Margin="4,0" MinHeight="36" VerticalAlignment="Center"/></Expander.Header>
       <StackPanel Margin="0,12,0,0">
        <DockPanel Margin="0,0,0,8">
         <Button DockPanel.Dock="Right" x:Name="NewTaskButton" Content="＋ 新建任务" Style="{StaticResource QuietButton}" Click="NewTaskClick" AutomationProperties.AutomationId="NewTask" Margin="8,0,0,0"/>
         <ComboBox DockPanel.Dock="Right" x:Name="TaskConcurrency" Width="110" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="TaskConcurrencyChanged" AutomationProperties.Name="任务队列并发上限" ToolTip="同时执行的队列任务数；仍受资源与工作目录保护">
          <ComboBoxItem Content="并发 1" Tag="1"/>
          <ComboBoxItem Content="并发 2" Tag="2"/>
          <ComboBoxItem Content="并发 3" Tag="3"/>
          <ComboBoxItem Content="并发 4" Tag="4"/>
         </ComboBox>
         <Button x:Name="QueueToggleButton" Content="执行队列" Click="QueueToggleClick" AutomationProperties.AutomationId="QueueToggle" Margin="0,0,8,0" VerticalAlignment="Top"/>
         <TextBlock x:Name="QueueStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock x:Name="TaskEmptyText" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel x:Name="TaskList"/>
       </StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel x:Name="SummaryPanel" Grid.Column="1">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
       <StackPanel>
        <DockPanel LastChildFill="False">
         <TextBlock DockPanel.Dock="Left" Text="电脑资源" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
         <Button DockPanel.Dock="Right" x:Name="ResourceSettingsButton" Content="资源模式 / 设置" Style="{StaticResource QuietButton}" Click="ResourceClick" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ResourceModeText" Text="资源模式：实用（默认）" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        <TextBlock x:Name="PoolSummaryText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="内存池摘要"/>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="现在可用内存" Style="{StaticResource Caption}"/><TextBlock x:Name="AvailableValue" Text="—" FontFamily="Consolas" FontSize="20" Margin="0,2,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="本次规划" Style="{StaticResource Caption}"/><TextBlock x:Name="BudgetValue" Text="—" FontFamily="Consolas" FontSize="20" Margin="0,2,0,0"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ResourceText" Style="{StaticResource Caption}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="CpuLimitText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        <Button x:Name="ReconcileButton" Content="核对并释放占用" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,4" Visibility="Collapsed" Click="ReconcileClick" AutomationProperties.Name="核对并释放占用" ToolTip="核对无存活进程的陈旧占用并释放其预约预算；仍在运行或无法证明的记录保持阻塞"/>
        <TextBlock Text="Job 上限是提交上限，不是当前占用；运行中仍可能分配失败或系统变卡。16 个可配置槽不表示 16 个 Agent 满载安全。" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
        <Expander x:Name="ResourceDetailsExpander" Margin="0,6,0,0" MinHeight="36" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="规划与余量明细" ToolTip="展开查看规划合计、硬保护余量、Job 上限对照与每项预算">
         <Expander.Header><TextBlock Text="规划与余量明细" FontWeight="SemiBold" Margin="4,0" MinHeight="36" VerticalAlignment="Center"/></Expander.Header>
         <StackPanel Margin="0,8,0,0">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="本次规划占用" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanningRequestedValue" Grid.Column="1" Text="—" FontFamily="Consolas"/>
           <TextBlock Grid.Row="1" Text="活动预约规划" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanningReservedValue" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Consolas"/>
           <TextBlock Grid.Row="2" Text="规划合计" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanningTotalValue" Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Consolas"/>
           <TextBlock Grid.Row="3" Text="硬保护后规划余量" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanningRemainingValue" Grid.Row="3" Grid.Column="1" Text="—" FontFamily="Consolas"/>
           <TextBlock Grid.Row="4" Text="若按 Job 上限加总" Style="{StaticResource Caption}"/><TextBlock x:Name="JobCapTotalValue" Grid.Row="4" Grid.Column="1" Text="—" FontFamily="Consolas"/>
          </Grid>
          <TextBlock x:Name="JobCapDifferenceText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock x:Name="PhysicalHeadroomText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock x:Name="CommitHeadroomText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock x:Name="PerSlotBudgetText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBlock Text="规划估算用于准入，不是该程序的实测占用；本产品没有按 Agent 种类给出的基准数据。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        <TextBlock Text="单位为 1024 进制：1 GiB = 1024 MiB。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
         </StackPanel>
        </Expander>
       </StackPanel>
      </Border>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
       <StackPanel>
        <UniformGrid Columns="4">
         <StackPanel><TextBlock Text="已配置" Style="{StaticResource Caption}"/><TextBlock x:Name="ConfiguredCountValue" Text="—" FontSize="20" FontFamily="Consolas" AutomationProperties.Name="已配置槽数"/></StackPanel>
         <StackPanel><TextBlock Text="已勾选" Style="{StaticResource Caption}"/><TextBlock x:Name="EnabledCountValue" Text="—" FontSize="20" FontFamily="Consolas" AutomationProperties.Name="已勾选槽数"/></StackPanel>
         <StackPanel><TextBlock Text="已预约" Style="{StaticResource Caption}"/><TextBlock x:Name="ReservedCountValue" Text="—" FontSize="20" FontFamily="Consolas" AutomationProperties.Name="monitor 活动预约数"/></StackPanel>
         <StackPanel><TextBlock Text="已启动进程" Style="{StaticResource Caption}"/><TextBlock x:Name="StartedCountValue" Text="—" FontSize="20" FontFamily="Consolas" AutomationProperties.Name="monitor 已确认 Started 数"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="预约包含运行中；状态未知显示 —。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBlock x:Name="CreatedPendingText" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
      <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="启动后的样子" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="终端预览" Style="{StaticResource Heading}"/></DockPanel>
      <Border Background="{DynamicResource PreviewPage}" BorderBrush="{DynamicResource PreviewLine}" BorderThickness="1" CornerRadius="10" Padding="12">
       <StackPanel>
        <DockPanel Margin="4,0,4,12"><TextBlock DockPanel.Dock="Right" x:Name="PaneCount" Text="1 个窗格" Foreground="{DynamicResource PreviewMuted}" FontSize="12"/><TextBlock Text="Windows Terminal" Foreground="{DynamicResource PreviewInk}" FontSize="12"/></DockPanel>
        <Grid x:Name="Preview" MinHeight="120"/>
       </StackPanel>
      </Border>
      <DockPanel Margin="0,8,0,16"><TextBlock Text="两个窗格的排法" Style="{StaticResource Caption}" VerticalAlignment="Center"/><ComboBox x:Name="Layout" Width="128" HorizontalAlignment="Right" SelectionChanged="LayoutChanged" AutomationProperties.Name="两项布局"><ComboBoxItem Content="左右并排" Tag="vertical"/><ComboBoxItem Content="上下叠放" Tag="horizontal"/></ComboBox></DockPanel>
      <TextBlock Text="文件夹策略" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="DirectoryMode" SelectionChanged="DirectoryChanged" AutomationProperties.Name="同项目目录策略"><ComboBoxItem Content="各自独立（互不影响）" Tag="isolated"/><ComboBoxItem Content="用已准备好的目录" Tag="prepared"/><ComboBoxItem Content="共用同一个文件夹" Tag="shared"/></ComboBox>
      <TextBlock x:Name="DirectoryHelp" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      <TextBlock Text="只为已勾选项准备目录；worktree 准备全局串行，取消不删除已创建目录。不修改 Terminal 全局设置，不承诺字体、间距或 scrollback。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
   <StackPanel>
    <Border x:Name="ErrorBanner" Background="{DynamicResource WarningSurface}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarningInk}" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer>
    </Border>
    <Grid x:Name="FooterGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="FooterMessage" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="LaunchHint" Text="先选择项目文件夹"/><DockPanel Margin="0,4,0,0"><Button x:Name="RetrySaveButton" DockPanel.Dock="Left" Content="重试保存" Style="{StaticResource QuietButton}" Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed" Click="RetrySaveClick" AutomationProperties.Name="重试保存"/><TextBlock x:Name="SaveStatus" Text="配置自动保存" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel></StackPanel>
     <WrapPanel x:Name="FooterActions" Grid.Column="1" VerticalAlignment="Center">
      <Button x:Name="CancelButton" Content="停止后续步骤" Style="{StaticResource QuietButton}" IsEnabled="False" Click="CancelClick" Margin="0,0,8,0"><Button.Visibility><Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" Converter="{StaticResource BooleanVisibility}"/></Button.Visibility></Button>
      <Button x:Name="QueueQuickButton" Content="按资源依次启动" Click="QueueQuickClick" AutomationProperties.AutomationId="QueueQuick" Margin="0,0,8,0" ToolTip="将勾选项固定为任务，按并发 1 等待资源；不改变原配置或终止活动任务"/>
      <Button x:Name="LaunchButton" Content="启动 1 个 Agent" Style="{StaticResource PrimaryButton}" MinWidth="168" Click="LaunchClick" AutomationProperties.AutomationId="Launch"/>
     </WrapPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
