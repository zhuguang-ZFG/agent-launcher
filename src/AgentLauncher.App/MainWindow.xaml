<Window x:Class="AgentLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="多 Agent 启动器" Width="1120" Height="800" WindowStartupLocation="CenterScreen"
 Icon="pack://application:,,,/Assets/app.ico"
 AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" x:Name="Rail" Width="232" Background="{DynamicResource RailSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="10,12">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
     <Button DockPanel.Dock="Right" Content="设置" Style="{StaticResource QuietButton}" Click="SettingsClick" AutomationProperties.AutomationId="Settings" Padding="6,2" MinHeight="26" FontSize="12"/>
     <DockPanel x:Name="Brand" VerticalAlignment="Center">
      <Border DockPanel.Dock="Left" Width="28" Height="28" Background="{DynamicResource Ink}" CornerRadius="6" Margin="0,0,10,0">
       <Path Data="M 7 8 L 11 12 L 7 16 M 14 16 L 20 16" Stroke="{DynamicResource Surface}" StrokeThickness="1.5"/>
      </Border>
      <TextBlock x:Name="BrandText" Text="多 Agent 启动器" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" x:Name="ProjectCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock x:Name="ProjectTitle" Text="还没有选择项目" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <TextBox x:Name="ProjectPath" Margin="0,8,0,0" FontFamily="Consolas,Microsoft YaHei" FontSize="12" AutomationProperties.Name="默认项目路径" AutomationProperties.AutomationId="ProjectPath" LostKeyboardFocus="ProjectLostFocus" ToolTip="输入本地绝对目录，或拖入文件夹"/>
      <DockPanel Margin="0,6,0,0">
       <Button DockPanel.Dock="Right" x:Name="ChooseProjectButton" Content="更换" Click="ChooseClick" AutomationProperties.AutomationId="ChooseProject" Style="{StaticResource QuietButton}" Padding="6,2" MinHeight="26" Margin="8,0,0,0" VerticalAlignment="Top"/>
       <TextBlock x:Name="ProjectGuide" Text="选择项目，勾选 Agent，然后启动。" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
      <ComboBox x:Name="Recent" Margin="0,6,0,0" SelectionChanged="RecentChanged" AutomationProperties.Name="最近项目" Visibility="Collapsed"/>
     </StackPanel>
    </Border>
    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
     <TextBlock DockPanel.Dock="Right" x:Name="SelectionSummary" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
     <TextBlock x:Name="AgentHeader" Text="Agent" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>
    <Border DockPanel.Dock="Bottom" x:Name="RailResource" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,8,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="RestoreBackupButton" Content="恢复备份" Click="RestoreBackupClick" Visibility="Collapsed" Margin="0,0,2,0" Padding="6,2" MinHeight="26" FontSize="12"/>
       <Button Content="更多" Style="{StaticResource QuietButton}" Click="MoreClick" Margin="0,0,2,0" Padding="6,2" MinHeight="26" FontSize="12" ToolTip="工作目录、资源设置、远程主机、恢复与诊断、运行历史与导出">
        <Button.ContextMenu><ContextMenu><MenuItem Header="工作目录" Click="WorkspacesClick"/><MenuItem Header="资源设置" Click="ResourceClick"/><MenuItem Header="远程主机（VPS）" Click="RemoteHostsClick" AutomationProperties.Name="远程主机"/><MenuItem Header="恢复与诊断" Click="TaskRecoveryClick"/><MenuItem Header="运行历史与导出" Click="TaskHistoryClick"/></ContextMenu></Button.ContextMenu>
       </Button>
       <Button Content="⚙" Style="{StaticResource QuietButton}" Click="ResourceClick" Padding="6,2" MinHeight="26" ToolTip="资源设置" AutomationProperties.Name="资源设置"/>
      </StackPanel>
      <TextBlock x:Name="RailResourceText" Text="资源：未读取 · 打开设置" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Border>
    <Button DockPanel.Dock="Bottom" x:Name="RailOverflow" Content="⋯" Style="{StaticResource QuietButton}" Visibility="Collapsed" MinHeight="26" Padding="2" ToolTip="更换项目、资源设置、更多" AutomationProperties.Name="窄屏菜单">
     <Button.ContextMenu><ContextMenu x:Name="RailOverflowMenu" Opened="RailOverflowMenuOpened">
      <MenuItem Header="更换项目" Click="ChooseClick"/>
      <MenuItem Header="资源设置" Click="ResourceClick"/>
      <MenuItem Header="远程主机（VPS）" Click="RemoteHostsClick" AutomationProperties.Name="远程主机"/>
      <MenuItem Header="工作目录" Click="WorkspacesClick"/>
      <MenuItem Header="恢复与诊断" Click="TaskRecoveryClick"/>
      <MenuItem Header="运行历史与导出" Click="TaskHistoryClick"/>
      <Separator/>
      <MenuItem x:Name="RailOverflowRestore" Header="恢复备份" Click="RestoreBackupClick"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
    <StackPanel DockPanel.Dock="Bottom" x:Name="RailSessionsSection" Margin="2,8,2,0">
     <TextBlock Text="会话与队列" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <StackPanel x:Name="RailSessions"/>
     <StackPanel x:Name="RailQueue" Margin="0,6,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <StackPanel x:Name="RailSlots"/>
      <Button x:Name="AddButton" Content="＋ 添加 Agent" Style="{StaticResource QuietButton}" Click="AddClick" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="添加 Agent"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="16,8,16,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ProjectSwitchButton" Style="{StaticResource QuietButton}" Click="ProjectSwitchClick" HorizontalContentAlignment="Stretch" Margin="0,0,8,0" AutomationProperties.Name="切换项目和最近项目">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text=" ▾" VerticalAlignment="Center"/><TextBlock x:Name="ProjectSwitchText" Text="选择项目…" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/></DockPanel>
    </Button>
    <Button x:Name="QuickActionsButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="QuickActionsClick" ToolTip="Ctrl+K · 搜索操作、Agent、最近项目和活动会话" AutomationProperties.Name="快捷操作 Ctrl+K"><TextBlock x:Name="QuickActionsText" Text="快捷操作  Ctrl+K" TextWrapping="NoWrap"/></Button>
   </Grid>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Editor" Margin="24,16,24,24">
     <Grid x:Name="WorkGrid">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConfigColumn" Width="*"/><ColumnDefinition x:Name="SummaryColumn" Width="320"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="ConfigurationPanel">
       <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
         <DockPanel Margin="0,0,0,10"><TextBlock x:Name="DetailTitle" Text="要一起启动的 Agent" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
         <Border Style="{StaticResource Card}" Padding="0"><StackPanel x:Name="SlotList"/></Border>
        </StackPanel>
       </Border>
       <Border x:Name="LongTaskNotice" Background="{DynamicResource WarningSurface}" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
        <DockPanel><Button x:Name="LongTaskButton" DockPanel.Dock="Right" Content="新任务上限改为 4 GiB" Click="LongTaskClick" Margin="12,0,0,0" ToolTip="增加内存余量，不保证任务不退出。新任务采用独立 4 GiB 上限和 1536 MiB 规划量；已有任务和排队计划保持原值"/><TextBlock x:Name="LongTaskText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningInk}"/></DockPanel>
       </Border>
       <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="16">
        <StackPanel>
         <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="启动后的样子" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="分屏预览" Style="{StaticResource Heading}"/></DockPanel>
         <Border Background="{DynamicResource PreviewPage}" BorderBrush="{DynamicResource PreviewLine}" BorderThickness="1" CornerRadius="10" Padding="12">
          <StackPanel>
           <DockPanel Margin="4,0,4,12"><TextBlock DockPanel.Dock="Right" x:Name="PaneCount" Text="1 个窗格" Foreground="{DynamicResource PreviewMuted}" FontSize="12"/><TextBlock Text="Windows Terminal" Foreground="{DynamicResource PreviewInk}" FontSize="12"/></DockPanel>
           <Grid x:Name="Preview" MinHeight="120"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>
       <Expander x:Name="LaunchOptionsExpander" Header="启动选项 · 目录与分屏" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Ink}">
        <StackPanel x:Name="SummaryPanel" Margin="0,12,0,0">
         <DockPanel Margin="0,8,0,16"><TextBlock Text="两个窗格的排法" Style="{StaticResource Caption}" VerticalAlignment="Center"/><ComboBox x:Name="Layout" Width="128" HorizontalAlignment="Right" SelectionChanged="LayoutChanged" AutomationProperties.Name="两项布局"><ComboBoxItem Content="左右并排" Tag="vertical"/><ComboBoxItem Content="上下叠放" Tag="horizontal"/></ComboBox></DockPanel>
         <TextBlock Text="文件夹策略" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <ComboBox x:Name="DirectoryMode" SelectionChanged="DirectoryChanged" AutomationProperties.Name="同项目目录策略"><ComboBoxItem Content="各自独立（互不影响）" Tag="isolated"/><ComboBoxItem Content="用已准备好的目录" Tag="prepared"/><ComboBoxItem Content="共用同一个文件夹" Tag="shared"/></ComboBox>
         <TextBlock x:Name="DirectoryHelp" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
         <TextBlock Text="只为已勾选项准备目录；worktree 准备全局串行，取消不删除已创建目录。不修改 Terminal 全局设置，不承诺字体、间距或 scrollback。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
       </Expander>
       <Expander x:Name="ConfigurationToolsExpander" Header="组合与批量设置" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Ink}">
        <StackPanel Margin="0,12,0,0">
         <WrapPanel x:Name="ScalePresets" Margin="0,0,0,8" AutomationProperties.Name="可配置规模预设">
          <TextBlock Text="规模预设" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Content="1" Tag="1" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 1"/>
          <Button Content="2" Tag="2" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 2"/>
          <Button Content="4" Tag="4" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 4"/>
          <Button Content="8" Tag="8" Click="ScalePresetClick" MinWidth="36" Margin="0,0,4,4" AutomationProperties.Name="规模预设 8"/>
          <Button Content="16" Tag="16" Click="ScalePresetClick" MinWidth="40" Margin="0,0,4,4" AutomationProperties.Name="规模预设 16"/>
         </WrapPanel>
         <TextBlock Text="只勾选的项会启动；预设用于补齐配置。缩小不会删除已编辑项。" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
         <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
           <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel VerticalAlignment="Center"><TextBlock Text="组合模板" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Templates" SelectionChanged="TemplateChanged" AutomationProperties.Name="恢复组合" MaxWidth="260" HorizontalAlignment="Left"/></DockPanel>
            <Button Grid.Column="1" x:Name="SaveTemplateButton" Content="存为组合" Style="{StaticResource QuietButton}" Click="SaveTemplateClick" Margin="8,0,0,0"/>
           </Grid>
           <DockPanel Margin="16,0,16,12">
            <Label Content="筛选下拉选项" Target="{Binding ElementName=AgentSearch}" VerticalAlignment="Center" Padding="0,0,8,0" ToolTip="只筛选各项的 Agent 下拉选项，不隐藏配置行，也不改变勾选"/>
            <TextBox x:Name="AgentSearch" AutomationProperties.Name="搜索 Agent 名称" AutomationProperties.HelpText="按名称筛选 Agent 下拉选项，不改变已勾选项" ToolTip="按名称筛选下拉选项；不会改变已选择的 Agent" TextChanged="AgentSearchChanged"/>
           </DockPanel>
           <Button x:Name="DiscoverButton" Content="重新查找本机 CLI" Style="{StaticResource QuietButton}" Click="DiscoverClick" HorizontalAlignment="Left" Margin="16,0,16,12"/>
           <TextBlock x:Name="DiscoveryStatus" Text="正在查找本机 CLI…" Style="{StaticResource Caption}" Margin="16,0,16,12" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Expander>
       <Expander x:Name="SessionExpander" Margin="0,16,0,0" MinHeight="36" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" ToolTip="展开查看本次与本机运行记录">
        <Expander.Header><TextBlock x:Name="SessionHeading" Text="运行记录" FontWeight="SemiBold" Margin="4,0" MinHeight="36" VerticalAlignment="Center"/></Expander.Header>
        <StackPanel Margin="0,12,0,0"><Button Content="查看全部历史与导出…" Click="TaskHistoryClick" HorizontalAlignment="Left" Margin="0,0,0,8"/><StackPanel x:Name="Sessions"/><TextBlock x:Name="ProgressText" Margin="0,8" AutomationProperties.LiveSetting="Polite"/></StackPanel>
       </Expander>
       <Border x:Name="QueueResumeBanner" Background="{DynamicResource WarningSurface}" Padding="10" Margin="0,8,0,0" Visibility="Collapsed"><DockPanel><Button x:Name="QueueResumeButton" DockPanel.Dock="Right" Content="继续上次队列" Click="QueueContinueClick" Margin="8,0,0,0"/><TextBlock x:Name="QueueResumeText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
       <Expander x:Name="TaskExpander" Margin="0,8,0,0" MinHeight="36" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="任务队列" ToolTip="任务卡片、队列与人工验收">
        <Expander.Header><TextBlock x:Name="TaskHeading" Text="任务队列" FontWeight="SemiBold" Margin="4,0" MinHeight="36" VerticalAlignment="Center"/></Expander.Header>
        <StackPanel Margin="0,12,0,0">
         <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" x:Name="NewTaskButton" Content="＋ 新建任务" Style="{StaticResource QuietButton}" Click="NewTaskClick" AutomationProperties.AutomationId="NewTask" Margin="8,0,0,0"/>
          <ComboBox DockPanel.Dock="Right" x:Name="TaskConcurrency" Width="110" Margin="8,0,0,0" VerticalAlignment="Top" SelectionChanged="TaskConcurrencyChanged" AutomationProperties.Name="任务队列并发上限" ToolTip="同时执行的队列任务数；仍受资源与工作目录保护">
           <ComboBoxItem Content="并发 1" Tag="1"/>
           <ComboBoxItem Content="并发 2" Tag="2"/>
           <ComboBoxItem Content="并发 3" Tag="3"/>
           <ComboBoxItem Content="并发 4" Tag="4"/>
          </ComboBox>
          <Button x:Name="QueueToggleButton" Content="执行队列" Click="QueueToggleClick" AutomationProperties.AutomationId="QueueToggle" Margin="0,0,8,0" VerticalAlignment="Top"/>
          <Button Content="后台运行" Click="BackgroundClick" ToolTip="收起到通知区域，队列和通知继续运行；双击图标或再次打开启动器可恢复" Margin="0,0,8,0" VerticalAlignment="Top"/>
          <TextBlock x:Name="QueueStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
         </DockPanel>
         <TextBlock Text="实际等待顺序（优先级高的先执行，同优先级按入队顺序）" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <StackPanel x:Name="QueueList" Margin="0,0,0,12"/>
         <DockPanel Margin="0,0,0,8"><ComboBox DockPanel.Dock="Right" x:Name="TaskFilter" SelectedIndex="0" Width="110" Margin="8,0,0,0" SelectionChanged="TaskFilterChanged" AutomationProperties.Name="任务范围"><ComboBoxItem Content="活动任务"/><ComboBoxItem Content="已归档"/><ComboBoxItem Content="全部任务"/></ComboBox><TextBox x:Name="TaskSearch" TextChanged="TaskSearchChanged" AutomationProperties.Name="搜索任务名称或项目" ToolTip="按任务名称、Agent 或项目路径搜索"/></DockPanel>
         <TextBlock x:Name="TaskEmptyText" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"/>
         <StackPanel x:Name="TaskList"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
    <StackPanel>
     <Border x:Name="ErrorBanner" Background="{DynamicResource WarningSurface}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"><TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource WarningInk}" AutomationProperties.Name="错误详情，可选择复制" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer>
     </Border>
     <Grid x:Name="FooterGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="FooterMessage" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="260"><TextBlock x:Name="LaunchHint" Text="先选择项目文件夹" TextWrapping="Wrap"/><DockPanel Margin="0,4,0,0"><TextBlock x:Name="SaveStatus" DockPanel.Dock="Left" Text="配置自动保存" Style="{StaticResource Caption}" VerticalAlignment="Center" MinWidth="80" MaxWidth="200" Margin="0,0,8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Button x:Name="RetrySaveButton" DockPanel.Dock="Left" Content="重试保存" Style="{StaticResource QuietButton}" Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed" Click="RetrySaveClick" AutomationProperties.Name="重试保存"/><Button x:Name="RefreshLaunchButton" DockPanel.Dock="Right" Content="重新检查" Style="{StaticResource QuietButton}" Padding="8,2" Click="RefreshLaunchClick"/><Button x:Name="ReconcileButton" DockPanel.Dock="Right" Content="核对并释放占用" Style="{StaticResource QuietButton}" Padding="8,2" Margin="4,0,0,0" Visibility="Collapsed" Click="ReconcileClick" AutomationProperties.Name="核对并释放占用" ToolTip="核对无存活进程的陈旧占用并释放其预约预算；仍在运行或无法证明的记录保持阻塞"/><TextBlock x:Name="MemoryBoardText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="320" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="内存：读取中…" AutomationProperties.Name="内存看板" AutomationProperties.AutomationId="MemoryBoard" ToolTip="VPS 会话在远端运行，降低本机内存占用"/></DockPanel></StackPanel>
      <WrapPanel x:Name="FooterActions" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
       <Button x:Name="CancelButton" Content="停止后续步骤" Style="{StaticResource QuietButton}" IsEnabled="False" Click="CancelClick" Margin="0,0,8,0"><Button.Visibility><Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" Converter="{StaticResource BooleanVisibility}"/></Button.Visibility></Button>
       <Button x:Name="QueueQuickButton" Content="按资源依次启动" Click="QueueQuickClick" AutomationProperties.AutomationId="QueueQuick" Margin="0,0,8,0" ToolTip="将勾选项固定为任务，按并发 1 等待资源；不改变原配置或终止活动任务"/>
       <Button x:Name="LaunchButton" Content="启动 1 个 Agent" Style="{StaticResource PrimaryButton}" MinWidth="168" Click="LaunchClick" AutomationProperties.AutomationId="Launch"/>
      </WrapPanel>
     </Grid>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
