<Window x:Class="AgentLauncher.App.QuickActionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AgentLauncher.App"
 Title="快捷操作" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
 PreviewKeyDown="OnKeyDown">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="搜索操作、Agent、项目或会话" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchChanged" Margin="0,0,0,8" MinHeight="38" Padding="12,8" local:Hint.Text="输入关键词，空格分隔多个词" AutomationProperties.Name="搜索快捷操作"/>
  <Grid Grid.Row="2">
   <ListBox x:Name="ActionList" SelectionChanged="SelectionChanged" MouseDoubleClick="OpenDoubleClick" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="匹配的快捷操作">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
     <Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
     <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Subtitle" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" FontSize="12" ToolTip="{Binding Detail}"/></StackPanel>
     <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Subtitle" Property="Foreground" Value="{DynamicResource SelectionInk}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="EmptyText" Text="没有匹配项，请换个关键词" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="打开" Click="OpenClick" IsEnabled="False" MinWidth="72" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="16,6"/>
   <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
   <TextBlock x:Name="ResultText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Grid>
</Window>
